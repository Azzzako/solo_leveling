{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "env": {
        "BROWSER": "chromium"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "flutter analyze*": "allow",
      "flutter test*": "allow",
      "dart run build_runner*": "allow",
      "dart format*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow"
    }
  }
}